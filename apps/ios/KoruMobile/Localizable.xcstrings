    "link_explainer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR الذي يعرضه Koru على حاسوبك. سيتلقّى هذا الهاتف نسخة محلية كاملة من ملفاتك الشخصية ومساحات عملك ومستنداتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie den QR-Code, den Koru auf Ihrem Computer anzeigt. Dieses Telefon erhält eine vollständige lokale Kopie Ihrer Profile, Arbeitsbereiche und Dokumente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code shown by Koru on your computer. This phone will receive a complete local copy of your profiles, workspaces, and documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR que muestra Koru en tu ordenador. Este teléfono recibirá una copia local completa de tus perfiles, espacios de trabajo y documentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code QR affiché par Koru sur votre ordinateur. Ce téléphone recevra une copie locale complète de vos profils, espaces de travail et documents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パソコンの Koru に表示された QR コードをスキャンしてください。この端末に、プロフィール・ワークスペース・ドキュメントの完全なローカルコピーが届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código QR exibido pelo Koru no seu computador. Este telefone receberá uma cópia local completa dos seus perfis, espaços de trabalho e documentos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描电脑上 Koru 显示的二维码。这台手机将收到你的个人资料、工作区和文档的完整本地副本。"
          }
        }
      }
    },
