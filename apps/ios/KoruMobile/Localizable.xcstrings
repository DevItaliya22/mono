    "start_over_explainer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مساحات عملك كما هي. تُنحَّى الهوية القديمة جانبًا، ويظهر هذا الهاتف كجهاز جديد بمجرد ربطه من جديد؛ احذف الإدخال القديم من أجهزتك الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Arbeitsbereiche bleiben erhalten. Die alte Identität wird beiseitegelegt, und dieses Telefon erscheint als neues Gerät, sobald Sie es erneut verknüpfen; entfernen Sie den alten Eintrag auf Ihren anderen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your workspaces stay. The old identity is set aside, and this phone appears as a new device once you link it again; remove the old entry from your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus espacios de trabajo se mantienen. La identidad antigua se aparta y este teléfono aparecerá como un dispositivo nuevo cuando vuelvas a vincularlo; elimina la entrada antigua en tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos espaces de travail sont conservés. L’ancienne identité est mise de côté et ce téléphone apparaîtra comme un nouvel appareil dès que vous l’associerez à nouveau ; supprimez l’ancienne entrée sur vos autres appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースはそのまま残ります。古い ID は脇に置かれ、もう一度リンクするとこの端末は新しいデバイスとして表示されます。他のデバイスからは古い項目を削除してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus espaços de trabalho permanecem. A identidade antiga é deixada de lado e este telefone aparece como um novo dispositivo quando você vinculá-lo de novo; remova a entrada antiga dos seus outros dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的工作区会保留。旧身份会被搁置，重新关联后这台手机将显示为一台新设备；请在你的其他设备上删除旧条目。"
          }
        }
      }
    },
