    "open_source_licenses_intro": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Koru برنامج حر بموجب رخصة موزيلا العامة 2.0 (Mozilla Public License 2.0). وهو مبني بعمل أشخاص كثيرين آخرين، وتراخيصهم معروضة هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koru ist freie Software unter der Mozilla Public License 2.0. Es ist mit der Arbeit vieler anderer Menschen gebaut, und ihre Lizenzen sind hier wiedergegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Koru is free software under the Mozilla Public License 2.0. It is built with the work of many other people, and their licenses are reproduced here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Koru es software libre bajo la Mozilla Public License 2.0. Está hecho con el trabajo de muchas otras personas, y sus licencias se reproducen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koru est un logiciel libre sous Mozilla Public License 2.0. Il est construit avec le travail de nombreuses autres personnes, dont les licences sont reproduites ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Koru は Mozilla Public License 2.0 のもとで提供されるフリーソフトウェアです。多くの人々の成果によって作られており、そのライセンスをここに掲載しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Koru é software livre sob a Mozilla Public License 2.0. Ele é feito com o trabalho de muitas outras pessoas, e as licenças delas estão reproduzidas aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Koru 是采用 Mozilla Public License 2.0 的自由软件。它凝聚了许多其他人的工作，他们的许可证复制于此。"
