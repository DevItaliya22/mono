    "identity_mismatch": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد مفاتيح هذا الهاتف تطابق هوية جهازه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüssel dieses Telefons passen nicht mehr zu seiner Geräteidentität"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone's keys no longer match its device identity"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de este teléfono ya no coinciden con su identidad de dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés de ce téléphone ne correspondent plus à son identité d’appareil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の鍵が、デバイス ID と一致しなくなりました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves deste telefone não correspondem mais à identidade do dispositivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机的密钥已与其设备身份不符"
          }
        }
      }
    },
    "identity_mismatch_explainer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدث هذا بعد حذف Koru وإعادة تثبيته، أو بعد استعادة بياناته من هاتف آخر. مساحات عملك سليمة، لكن هذا الهاتف لا يمكنه المزامنة أو الربط حتى يبدأ من جديد كجهاز جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das passiert, nachdem Koru gelöscht und neu installiert wurde oder seine Daten von einem anderen Telefon wiederhergestellt wurden. Ihre Arbeitsbereiche sind unversehrt, aber dieses Telefon kann sich weder synchronisieren noch verknüpfen, bis es als neues Gerät von vorn beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This happens after Koru is deleted and reinstalled, or its data is restored from another phone. Your workspaces are intact, but this phone cannot sync or link until it starts over as a new device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ocurre después de eliminar y volver a instalar Koru, o de restaurar sus datos desde otro teléfono. Tus espacios de trabajo están intactos, pero este teléfono no podrá sincronizarse ni vincularse hasta que empiece de cero como un dispositivo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela se produit après la suppression puis la réinstallation de Koru, ou lorsque ses données sont restaurées depuis un autre téléphone. Vos espaces de travail sont intacts, mais ce téléphone ne peut ni se synchroniser ni s’associer tant qu’il ne repart pas de zéro comme nouvel appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは、Koru を削除して再インストールしたあと、または別の端末からデータを復元したあとに起こります。ワークスペースは無事ですが、この端末は新しいデバイスとしてやり直すまで、同期もリンクもできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso acontece depois que o Koru é excluído e reinstalado, ou quando os dados dele são restaurados de outro telefone. Seus espaços de trabalho estão intactos, mas este telefone não consegue sincronizar nem vincular até recomeçar como um novo dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会在 Koru 被删除并重新安装之后，或其数据从另一台手机恢复之后出现。你的工作区完好无损，但在这台手机以新设备身份重新开始之前，它无法同步或关联。"
          }
        }
      }
    },
