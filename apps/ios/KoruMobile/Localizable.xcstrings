    "history_empty": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُستلم من هذا الجهاز أي تغييرات في الفهرس أو الملف الشخصي أو مساحة العمل أو المستند أو الكائن الثنائي (blob)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem Gerät wurden keine Änderungen an Katalog, Profil, Arbeitsbereich, Dokument oder Blob empfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No catalog, profile, workspace, document, or blob changes have been received from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha recibido de este dispositivo ningún cambio de catálogo, perfil, espacio de trabajo, documento o blob."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune modification de catalogue, de profil, d’espace de travail, de document ou de blob n’a été reçue de cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからは、カタログ・プロフィール・ワークスペース・ドキュメント・blob のいずれの変更も受信していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma alteração de catálogo, perfil, espaço de trabalho, documento ou blob foi recebida deste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未从这台设备收到任何目录、个人资料、工作区、文档或二进制对象 (blob) 的变更。"
          }
        }
      }
    },
