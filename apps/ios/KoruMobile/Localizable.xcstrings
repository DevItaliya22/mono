    "use_relay_explainer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف تتوقف الاتصالات عبر المُرحِّل لهذا الجهاز فقط؛ وتستمر المزامنة عبر الشبكة نفسها أو عبر اتصال مباشر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus stoppt nur die Relay-Verbindungen dieses Geräts; die Synchronisierung im selben Netzwerk oder über eine direkte Verbindung läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off stops relayed connections for this device only; syncing on the same network or over a direct connection continues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivarlo se detienen solo las conexiones por relay de este dispositivo; la sincronización en la misma red o por conexión directa continúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, seules les connexions relayées de cet appareil s’arrêtent ; la synchronisation sur le même réseau ou en connexion directe continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするとこの端末のリレー経由の接続のみ停止します。同じネットワーク内や直接接続での同期は継続します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, apenas as conexões por relay deste dispositivo param; a sincronização na mesma rede ou por conexão direta continua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后仅停止此设备的中继连接；同一网络内或直接连接的同步仍会继续。"
          }
        }
      }
    },
