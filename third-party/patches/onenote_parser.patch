+
+/// OneNote writes an extended GUID in hyperlinks as `{GUID}&HEX_VALUE`.
+fn format_link_target_id(id: ExGuid) -> String {
+    format!("{}&{:X}", id.guid, id.value)
+}
+
+#[cfg(test)]
+mod link_target_tests {
+    use super::format_link_target_id;
+    use crate::fsshttpb::data::exguid::ExGuid;
+    use crate::shared::guid::Guid;
+    use uuid::Uuid;
+
+    #[test]
+    fn an_extended_guid_uses_onenotes_hyperlink_spelling() {
+        let id = ExGuid {
+            guid: Guid(Uuid::parse_str("65aae0af-75fe-05c5-07b5-3e406fe22be2").unwrap()),
+            value: 0xE,
+        };
+
+        assert_eq!(
+            format_link_target_id(id),
+            "{65AAE0AF-75FE-05C5-07B5-3E406FE22BE2}&E"
+        );
+    }
+}
